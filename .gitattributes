# Stable source bytes across Windows checkouts for experiment/recovery hashes.
*.py text eol=lf
*.ps1 text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.txt text eol=lf
*.md text eol=lf
requirements-lock.txt text eol=crlf
.gitignore text eol=lf
.gitattributes text eol=lf
# Preserve raw experiment records and artifacts byte-for-byte.
*.csv -text
*.json -text
*.zip binary
*.png binary
